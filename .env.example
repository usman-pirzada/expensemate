APP_NAME=ExpenseMate
# Used for local development outside Docker. Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./data/expensemate.db

# Docker Compose PostgreSQL settings. Change the development password before deployment.
POSTGRES_DB=expensemate
POSTGRES_USER=expensemate
POSTGRES_PASSWORD=change_this_password

# Existing SQLite Compose volume from the previous Compose setup.
# Replace this with the exact value reported by: docker volume ls
LEGACY_SQLITE_VOLUME=expensemate_expensemate-data

# Optional: use this instead when the SQLite file is exported into ./data/expensemate.db.
# SOURCE_DATABASE_URL=sqlite:////legacy-data/expensemate.db
